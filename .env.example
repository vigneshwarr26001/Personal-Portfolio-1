# Public URL of the deployed site, used for canonical URLs, Open Graph, robots.txt and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# EmailJS (https://dashboard.emailjs.com) — used by the contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
